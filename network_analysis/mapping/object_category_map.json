 "normalize_surface": {
  "$comment": "適用順。表層形を小文字化したうえで順に適用する",
  "rules": [
   {
    "pattern": "<[a-z]=[A-Za-z]>",
    "replace": "",
    "note": "翻刻の訂正記号 mon<u=I>mentum → monmentum を避けるため、左辺のみ残す処理は expand_correction で行う"
   },
   {
    "pattern": "\\(([^)]*)\\)",
    "replace": "\\1",
    "note": "略号展開 fec(it) → fecit"
   },
   {
    "pattern": "\\[([^\\]]*)\\]",
    "replace": "\\1",
    "note": "欠損補填 [miliari]a → miliaria"
   },
   {
    "pattern": "\\s+",
    "replace": " ",
    "note": "空白正規化"
   },
   {
    "pattern": "[!?]+$",
    "replace": "",
    "note": "不確実マーカー除去"
   }
  ],
  "expand_correction": {
   "$comment": "<u=I> 形式は『正しい読み=刻まれた字』。左辺を採用する",
   "pattern": "<([a-z]+)=[A-Za-z]+>",
   "replace": "\\1"
  }
 },
